phpcq:
  repositories:
    # Generated by bin/build-local-repository.php on composer install/update, provides the plugin of this checkout.
    - .phpcq/repository/repository.json
    - https://phpcq.github.io/repository/repository.json
  directories:
    - src
    - tests
  artifact: .phpcq/build

  plugins:
    phpunit:
      version: ^1.0
      signed: false
    psalm:
      version: ^1.0
      signed: false
    composer-require-checker:
      version: ^1.0
      signed: false
    phpmd:
      version: ^1.0
      signed: false
      requirements:
        phpmd:
          signed: false
    phpcpd:
      version: ^1.1.1
      signed: false
    phploc:
      version: ^1.0
      signed: false
    phpcs:
      version: ^1.0
      signed: false
    composer-normalize:
      version: ^1.0
      signed: false
    composer-dependency-analyser:
      version: ^1.0
      signed: false
  # Trusted keys from ../phpcq/.phpcq.yaml.dist plus 96E91A992CF22FF4 (signs phpcs 4.x).
  trusted-keys:
    # composer-require-checker
    - 033E5F8D801A2F8D
    # sb@sebastian-bergmann.de
    - 4AA394086372C20A
    # psalm
    - 8A03EA3B385DBAA1
    - 12CE0F1D262429A5
    - 99BF4D9A33D65E1E
    # magl@magll.net
    - D2CCAC42F6295E7D
    # PHP_CodeSniffer
    - 31C7E470E2138192
    - 96E91A992CF22FF4
    - 2DF45277AEF09A2F
    - 5E6DDE998AB73B8E
    - A978220305CD5C32
    - 97B02DD8E5071466
    # Composer normalize
    - C00543248C87FB13
    # PHPMD
    - 9093F8B32E4815AA

tasks:
  fix:
    - composer-normalize-fix
    - phpcbf

  verify:
    - composer-require-checker
    - composer-normalize
    - composer-dependency-analyser

  analyze:
    - phploc
    - phpcpd
    - phpmd
    - phpcs
    - psalm
    - phpunit

  default:
    - verify
    - analyze

  phpmd:
    config:
      ruleset:
        - cleancode
        - codesize
        - controversial
        - design
        - naming
        - unusedcode

  composer-require-checker:
    config:
      config_file: '.composer-require-checker.json'

  phpcs:
    config: &phpcs-config
      standard: PSR12

  phpcbf:
    plugin: phpcs
    config:
      <<: *phpcs-config
      fix: true

  phpcpd:
    config:

  composer-normalize-fix:
    plugin: composer-normalize
    config:
      dry_run: false
